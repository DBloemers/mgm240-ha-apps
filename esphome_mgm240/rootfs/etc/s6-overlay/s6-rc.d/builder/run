#!/command/with-contenv bashio
set -e

export ESPHOME_IS_HA_ADDON=true
export ESPHOME_BUILD_PATH=/data/build
export CMAKE_BUILD_PARALLEL_LEVEL=2

mkdir -p /data/configs
if [[ ! -f /data/.nano-matter-initialized ]]; then
    if [[ ! -e /data/configs/nano-matter-smoke.yaml ]]; then
        cp /opt/nano-matter-smoke.yaml /data/configs/nano-matter-smoke.yaml
    fi
    touch /data/.nano-matter-initialized
fi

exec esphome-device-builder /data/configs \
    --ha-addon --ingress-port "$(bashio::addon.ingress_port)"
